# Optional public settings. No API keys or private gateway URLs belong here.
# Desktop scripts do not automatically load this file.
# macOS/Linux: copy to .env.local, review, then: set -a; . ./.env.local; set +a
# PowerShell: set each desired value using $env:NAME = "value".
LANCER_LOCALE=zh-CN
FFMPEG=ffmpeg
FFPROBE=ffprobe
YT_DLP=yt-dlp
# Extra roots join workspace changes in the same turn view; see
# docs/external-capture-roots.md. Semicolon-separated absolute Git checkouts.
LANCER_EXTRA_CAPTURE_ROOTS=

# Optional website build settings: public URLs only. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_LANCER_GITHUB_URL=
NEXT_PUBLIC_LANCER_SITE_URL=
NEXT_PUBLIC_LANCER_RELEASES_AVAILABLE=false
